HOST=127.0.0.1
PORT=3211
COWORKER_UPSTREAM=widget
COWORKER_DATA_DIR=data
# Required before adding native provider credentials: 32 random bytes encoded
# as 64 hex characters. Keep outside backups of the encrypted provider store.
# Losing this master key makes stored provider credentials unrecoverable.
MASTER_ENCRYPTION_KEY=
# Desktop stays loopback-only. For Docker/reverse-proxy deployments explicitly
# opt in and bootstrap a 12-256 character password before opening the listener.
# Network setup is always forbidden; this password never replaces an existing one.
COWORKER_ADMIN_ALLOW_REMOTE=false
COWORKER_ADMIN_PASSWORD=
# Default blocks private/reserved native provider addresses and plain HTTP.
# Enable only deliberately for a trusted LAN/local upstream deployment.
ALLOW_PRIVATE_UPSTREAMS=false
# Create API keys from the dashboard. Legacy comma-separated static keys are optional.
COWORKER_API_KEYS=
# Single-process per-key rolling-minute and concurrent inference admission.
COWORKER_REQUESTS_PER_MINUTE=60
COWORKER_CONCURRENT_REQUESTS=4
# Use one long random value. A tunnel-client forwarding to /mcp must inject
# Authorization: Bearer <this value> on requests from ChatGPT.
COWORKER_MCP_SECRET=replace-with-a-long-random-secret
# Optional official tunnel-client connection for ChatGPT Web. Leave all three
# empty to run local-only; fill all three to expose /mcp through your tunnel.
COWORKER_TUNNEL_BIN=
COWORKER_TUNNEL_ID=
COWORKER_TUNNEL_API_KEY=
# Optional legacy Coworker desktop bridge secret. Not needed for standalone widget mode.
# COWORKER_BRIDGE_SECRET=
COWORKER_BRIDGE_TIMEOUT_MS=300000
COWORKER_MODELS=chatgpt-web
# Experimental personal-account MCP App widget bridge. Connect the ChatGPT
# plugin to this service's /mcp endpoint, open a ChatGPT conversation, and
# call workbench_api_activate. Text and client function calls are experimental.
# Experimental official Workspace Agent trigger + MCP callback mode:
# COWORKER_UPSTREAM=workspace-agent
# WORKSPACE_AGENT_TRIGGER_ID=agtch_...
# WORKSPACE_AGENT_ACCESS_TOKEN=...
# COWORKER_MCP_SECRET=local-mcp-test-secret
