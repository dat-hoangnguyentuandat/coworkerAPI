{
  "name": "coworker-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "files": [
    "assets/guide",
    "dist/src",
    "bin",
    "scripts",
    ".env.example",
    "README.md",
    "BRIDGE.md",
    "INTEGRATION_STATUS.md",
    "WORKSPACE_AGENT_POC.md"
  ],
  "main": "dist/src/index.js",
  "bin": {
    "coworkerapi": "bin/coworkerapi.mjs"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "exports": {
    ".": "./dist/src/index.js",
    "./bridge-agent": "./dist/src/bridge-agent.js",
    "./protocol": "./dist/src/protocol.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "local": "node bin/coworkerapi.mjs start",
    "doctor": "node bin/coworkerapi.mjs doctor",
    "test:live:claude": "node scripts/live-claude-e2e.mjs",
    "test:live:codex": "node scripts/live-codex-e2e.mjs",
    "test:live:opencode": "node scripts/live-opencode-e2e.mjs",
    "test:live:protocols": "node scripts/live-protocol-e2e.mjs",
    "test:live:recovery": "node scripts/live-recovery-e2e.mjs",
    "test": "npm run build && node --test --import tsx tests/**/*.test.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "@fastify/cors": "^11.0.1",
    "@fastify/websocket": "^11.2.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "fastify": "^5.4.0",
    "ws": "^8.22.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/ws": "^8.18.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
